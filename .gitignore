# The repo root is the WordPress install root; only the wp-content projects
# below are versioned. Whitelist approach: ignore everything, then re-include.
/*

# Keep this ignore file.
!/.gitignore

# Only descend into wp-content, and only the projects below within it.
!/wp-content/
/wp-content/*

# Our custom theme.
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/orillia-eagles/

# Our custom plugins (third-party plugins stay ignored).
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/orillia-players/
!/wp-content/plugins/team-membership-ledger/

# Never commit brainstorming/spec docs, anywhere in the repo.
**/docs/superpowers/specs/
